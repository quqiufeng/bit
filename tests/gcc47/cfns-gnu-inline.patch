Subject: [PATCH] cp: drop stale libc_name_p prototype for modern g++

--- a/gcc/cp/cfns.gperf
+++ b/gcc/cp/cfns.gperf
@@ -20,10 +20,6 @@
 __inline
 #endif
 static unsigned int hash (const char *, unsigned int);
-#ifdef __GNUC__
-__inline
-#endif
-const char * libc_name_p (const char *, unsigned int);
 %}
 %%
 # The standard C library functions, for feeding to gperf; the result is used
--- a/gcc/cp/cfns.h
+++ b/gcc/cp/cfns.h
@@ -51,10 +51,6 @@
 __inline
 #endif
 static unsigned int hash (const char *, unsigned int);
-#ifdef __GNUC__
-__inline
-#endif
-const char * libc_name_p (const char *, unsigned int);
 /* maximum key range = 391, duplicates = 0 */
 
 #ifdef __GNUC__
